{
  "name": "@apps/atlas",
  "version": "0.5.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Data Atlas's inbound part: its API behind the gateway at /api/atlas, and the events AUGUR pushes to it.",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp ../manifest.json dist/manifest.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@augur/service-kit": "npm:@harry-burton-dev/augur-service-kit@^0.18.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
