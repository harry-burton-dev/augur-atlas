{
  "$schema": "./node_modules/@augur/app-tools/manifest-3.schema.json",
  "id": "atlas",
  "name": "Data Atlas",
  "version": "0.5.0",
  "contract": 3,
  "description": "The things your organisation knows about, and what is known of them",
  "icon": "atlas",
  "floors": [
    "personal",
    "team",
    "org"
  ],
  "frontend": {
    "entry": "sandbox.js"
  },
  "api": {
    "openapi": "openapi.json"
  },
  "scopes": [
    "knowledge:read",
    "knowledge:act",
    "people:read",
    "events:subscribe"
  ],
  "contributes": {
    "places": [
      {
        "id": "find",
        "label": "Find",
        "icon": "find",
        "path": "/"
      }
    ],
    "about": [
      {
        "id": "details",
        "label": "Details",
        "icon": "info"
      }
    ]
  }
}
